@startuml
title WarmHouse System — Container Diagram (To-Be)

!include ../vendor/C4-PlantUML/C4_Container.puml


AddRelTag("async", $textColor="#000000", $lineColor="#E67E22", $lineStyle=DashedLine())
AddRelTag("media", $textColor="#000000", $lineColor="#8E44AD", $lineStyle=DashedLine())

Person(user, "User", "Владелец дома: сам подключает модули, управляет устройствами, смотрит телеметрию и видео")
Person(admin, "Administrator", "Сотрудник сервиса: дома, устройства, доступы")

System_Ext(houses, "Houses (1..N)", "Хаб умного дома с модулями: отопление, свет, ворота, камеры, датчики")

System_Boundary(warmhouse, "WarmHouse System") {

  Container(WebApp, "Web Application", "React, TypeScript", "Мониторинг, управление модулями и устройствами; обновление данных опросом")

  Container(ApiGateway, "API Gateway", "Nginx", "JWT-аутентификация, rate limiting, логирование, маршрутизация")

  Container_Boundary(core, "Core Services (As-Is domains)") {
    Container(UserService, "User Service", "Python, FastAPI", "Домен «Пользователи»: аккаунты, роли, аутентификация")
    Container(HouseService, "House Service", "Python, FastAPI", "Домен «Дома»: дома, доступы")
    Container(DeviceService, "Device Service", "Python, FastAPI", "Домен «Устройства»: реестр устройств, подключение, capabilities")

    ContainerDb(CoreDb, "Core DB", "PostgreSQL", "Единая БД доменов: пользователи, роли, дома, права, типы устройств, capabilities, статусы")
  }

  Container_Boundary(automation, "Home Automation Services (To-Be)") {
    Container(DeviceControlService, "Device Control Service", "Python, FastAPI", "Универсальное управление всеми типами устройств: команды, состояния, валидация по capabilities")
    ContainerDb(DeviceControlDb, "Device Control DB", "PostgreSQL", "Состояния устройств, очередь команд, история команд")
  }

  Container_Boundary(telemetry, "Telemetry Platform (To-Be)") {
    Container(IngestService, "Telemetry Ingest API", "Python, FastAPI, Pydantic", "Валидация batch JSON, очередь, 202 Accepted")
    Container(QueryService, "Telemetry Query API", "Python, FastAPI", "Текущие значения и история для UI")
    ContainerQueue(MessageBroker, "Message Broker", "RabbitMQ", "telemetry.raw")
    Container(TelemetryWorker, "Telemetry Workers", "Python, Celery", "Нормализация, дедупликация, батч-запись")
    ContainerDb(TelemetryDb, "Telemetry DB", "PostgreSQL", "История показаний")
  }

  Container_Boundary(video, "Video Platform (To-Be)") {
    Container(VideoGateway, "Video Streaming Gateway", "WebRTC / HLS", "Удалённое наблюдение: приём потока от камер и раздача в браузер")
  }
}

Rel(user, WebApp, "Использует", "HTTPS")
Rel(admin, WebApp, "Управляет", "HTTPS")

Rel(WebApp, ApiGateway, "REST/JSON; опрос GET /telemetry/latest", "HTTPS")
Rel(WebApp, VideoGateway, "Просмотр камер", "HTTPS / WebRTC", $tags="media")

Rel(houses, ApiGateway, "POST /devices/pair, POST /ingest, GET /commands", "HTTPS")
Rel(houses, VideoGateway, "Публикация потока", "RTSP / WebRTC", $tags="media")

Rel(ApiGateway, UserService, "/auth, /users", "REST")
Rel(ApiGateway, HouseService, "/houses", "REST")
Rel(ApiGateway, DeviceService, "/devices", "REST")
Rel(ApiGateway, DeviceControlService, "/control, /commands", "REST")
Rel(ApiGateway, IngestService, "/ingest", "REST")
Rel(ApiGateway, QueryService, "/telemetry", "REST")

Rel(UserService, CoreDb, "Читает/пишет")
Rel(HouseService, CoreDb, "Читает/пишет")
Rel(DeviceService, CoreDb, "Читает/пишет")
Rel(DeviceControlService, DeviceControlDb, "Читает/пишет")

Rel(DeviceControlService, DeviceService, "Проверяет capabilities и тип устройства", "REST")

Rel(IngestService, MessageBroker, "telemetry.raw", "AMQP", $tags="async")
Rel(MessageBroker, TelemetryWorker, "telemetry.raw", "AMQP", $tags="async")
Rel(TelemetryWorker, TelemetryDb, "Батч-запись", "SQL")
Rel(QueryService, TelemetryDb, "Чтение", "SQL")

@enduml
