@startuml
title WarmHouse System — Container Diagram (To-Be)

!include ../vendor/C4-PlantUML/C4_Container.puml


AddRelTag("async", $textColor="#000000", $lineColor="#E67E22", $lineStyle=DashedLine())
AddRelTag("command", $textColor="#000000", $lineColor="#C0392B", $lineStyle=DashedLine())

Person(user, "User", "Владелец дома: мониторинг температуры и управление отоплением")
Person(admin, "Administrator", "Сотрудник сервиса: дома, устройства, доступы")

System_Ext(houses, "Houses (1..N)", "Датчики температуры и системы отопления в домах клиентов")

System_Boundary(warmhouse, "WarmHouse System") {

  Container(WebApp, "Web Application", "React, TypeScript", "Мониторинг, управление отоплением, история показаний; обновление данных опросом")

  Container(ApiGateway, "API Gateway", "Nginx", "JWT-аутентификация, rate limiting, логирование, маршрутизация")

  Container_Boundary(core, "Core Domain Services (As-Is domains)") {
    Container(UserService, "User Service", "Python, FastAPI", "Домен «Пользователи»: аккаунты, роли, аутентификация")
    ContainerDb(UserDb, "Users DB", "PostgreSQL", "Пользователи и роли")

    Container(HouseService, "House Service", "Python, FastAPI", "Домен «Дома»: дома, комнаты, привязка пользователей")
    ContainerDb(HouseDb, "Houses DB", "PostgreSQL", "Дома, комнаты, права доступа")

    Container(DeviceService, "Device Service", "Python, FastAPI", "Домен «Устройства»: реестр датчиков и систем отопления")
    ContainerDb(DeviceDb, "Devices DB", "PostgreSQL", "Устройства, привязка к домам, статусы")

    Container(HeatingService, "Heating Control Service", "Python, FastAPI", "Домен «Отопление»: расписания, сценарии")
    ContainerDb(HeatingDb, "Heating DB", "PostgreSQL", "Расписания, режимы")
  }

  Container_Boundary(telemetry, "Telemetry Platform (To-Be)") {
    Container(IngestService, "Telemetry Ingest API", "Python, FastAPI, Pydantic", "Валидация batch JSON, постановка в очередь, ответ 202 Accepted")
    Container(QueryService, "Telemetry Query API", "Python, FastAPI", "Текущие значения и история показаний для UI: пагинация и агрегаты")
    ContainerQueue(MessageBroker, "Message Broker", "RabbitMQ", "telemetry.raw, heating.commands")
    Container(TelemetryWorker, "Telemetry Workers", "Python, Celery", "Нормализация, дедупликация, батч-запись")
    ContainerDb(TelemetryDb, "Telemetry DB", "PostgreSQL", "История показаний")
    Container(CommandService, "Device Command Service", "Python, FastAPI", "Хранит новые настройки для домов; дома забирают их опросом GET /commands")
    ContainerDb(CommandDb, "Commands DB", "PostgreSQL", "Очередь невыданных команд и статусы доставки")
  }
}

Rel(user, WebApp, "Использует", "HTTPS")
Rel(admin, WebApp, "Управляет", "HTTPS")

Rel(WebApp, ApiGateway, "REST/JSON; обновление данных опросом GET /telemetry/latest", "HTTPS")

Rel(houses, ApiGateway, "POST /ingest: batch JSON с показаниями, GET /commands: получение новых настроек", "HTTPS")

Rel(ApiGateway, UserService, "Маршрутизация /auth, /users", "REST")
Rel(ApiGateway, HouseService, "Маршрутизация /houses", "REST")
Rel(ApiGateway, DeviceService, "Маршрутизация /devices", "REST")
Rel(ApiGateway, HeatingService, "Маршрутизация /heating", "REST")
Rel(ApiGateway, IngestService, "Маршрутизация /ingest", "REST")
Rel(ApiGateway, QueryService, "Маршрутизация /telemetry", "REST")
Rel(ApiGateway, CommandService, "Маршрутизация /commands", "REST")

Rel(UserService, UserDb, "Читает/пишет")
Rel(HouseService, HouseDb, "Читает/пишет")
Rel(DeviceService, DeviceDb, "Читает/пишет")
Rel(HeatingService, HeatingDb, "Читает/пишет")
Rel(CommandService, CommandDb, "Читает/пишет")

Rel(IngestService, MessageBroker, "Публикует telemetry.raw", "AMQP", $tags="async")
Rel(MessageBroker, TelemetryWorker, "Доставляет telemetry.raw", "AMQP", $tags="async")
Rel(TelemetryWorker, TelemetryDb, "Батч-запись показаний", "SQL")
Rel(QueryService, TelemetryDb, "Читает текущие значения и историю", "SQL")

Rel(HeatingService, MessageBroker, "Команды heating.commands", "AMQP", $tags="command")
Rel(MessageBroker, CommandService, "Команды для домов", "AMQP", $tags="command")

SHOW_LEGEND()

@enduml
